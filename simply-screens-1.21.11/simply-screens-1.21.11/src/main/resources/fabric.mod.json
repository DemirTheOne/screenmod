{
  "schemaVersion": 1,
  "id": "simply_screens",
  "version": "${version}",
  "name": "Simply Screens (Fabric 1.21.11 port)",
  "description": "Screen blocks that display images from local files or URLs. Multi-block displays up to 64x64 and Screen ID networks. Standalone port: no OpenUI/PacketWeave required.",
  "authors": ["nstut (original)", "Fabric 1.21.11 port"],
  "contact": { "sources": "https://github.com/UpperMoon0/Simply-Screens" },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": ["com.nstut.simplyscreens.SimplyScreens"],
    "client": ["com.nstut.simplyscreens.client.SimplyScreensClient"]
  },
  "depends": {
    "fabricloader": ">=0.18.0",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  }
}
